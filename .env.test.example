DATABASE_URL=postgresql://boxadmin:boxadmin_dev@localhost:5433/boxadmin_test?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=test_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

BOOTSTRAP_KEY=test_bootstrap_key

PORT=3001
NODE_ENV=test

# Limites MUY altos a proposito: crearGimnasio hace un login por cada beforeEach
# y un solo archivo encadena mas de treinta contra la misma IP. Con el limite de
# produccion (5/min) los e2e empezarian a dar 429 a partir del sexto test.
# El throttler se ejercita aparte, en throttling.e2e-spec.ts, que se baja el
# limite a mano antes de levantar la app.
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=100000
THROTTLE_GENERAL_TTL=60000
THROTTLE_GENERAL_LIMIT=100000

# Almacen de comprobantes. `local` guarda en disco con URLs firmadas por HMAC;
# `s3` habla el protocolo de S3 (Backblaze B2, DigitalOcean Spaces o el propio
# S3) y entonces exige tambien S3_ENDPOINT, S3_REGION, S3_BUCKET,
# S3_ACCESS_KEY_ID y S3_SECRET_ACCESS_KEY.
ALMACEN_TIPO=local
ALMACEN_LOCAL_DIR=./var/almacen
API_BASE_URL=http://localhost:3000
