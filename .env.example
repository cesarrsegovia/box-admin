DATABASE_URL=postgresql://boxadmin:boxadmin_dev@localhost:5434/boxadmin?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=changeme_dev_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_dev_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

BOOTSTRAP_KEY=changeme_bootstrap_key

PORT=3000
NODE_ENV=development

# Limites de peticiones por IP. Los valores por defecto del codigo son los
# estrictos (5 intentos/min en las rutas publicas de auth); estas variables
# existen sobre todo para que los tests puedan aflojarlos.
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_GENERAL_TTL=60000
THROTTLE_GENERAL_LIMIT=300

# Almacen de comprobantes. `local` guarda en disco con URLs firmadas por HMAC;
# `s3` habla el protocolo de S3 (Backblaze B2, DigitalOcean Spaces o el propio
# S3) y entonces exige tambien S3_ENDPOINT, S3_REGION, S3_BUCKET,
# S3_ACCESS_KEY_ID y S3_SECRET_ACCESS_KEY.
ALMACEN_TIPO=local
ALMACEN_LOCAL_DIR=./var/almacen
API_BASE_URL=http://localhost:3000

# Origen del frontend (Fase 3B). Sin el, no se habilita CORS. Solo hace falta
# para el PUT del comprobante, que va directo del navegador al almacen.
WEB_ORIGIN=http://localhost:3001
